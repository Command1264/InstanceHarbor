{
  "productName": "InstanceHarbor",
  "version": "1.0.1",
  "identifier": "local.instanceharbor",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "InstanceHarbor",
        "width": 1380,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
